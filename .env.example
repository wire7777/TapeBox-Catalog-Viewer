# TapeBox Catalog Viewer Docker user mapping

# Set these to the UID and GID that should own files in ./data
# Check your values with: id

PUID=1000
PGID=1000

# Optional default TapeBox catalog URL
# The Viewer Settings page can also configure the server.
# TAPEBOX_CATALOG_URL=http://TAPEBOX-SERVER-IP:8080/api/catalog-mirror/download
